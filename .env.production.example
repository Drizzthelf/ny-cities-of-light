# Values for the PRODUCTION Supabase project (Pro plan, Micro compute).
# Copy to .env.production and fill in from that project's
# Project Settings → API page. Never commit the real file.
EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key-here
# hCaptcha site key (public — the matching secret key goes in the Supabase
# dashboard, never here). Leave unset to skip the captcha step entirely.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here
