EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# hCaptcha site key (public, safe to ship in the app — the secret key goes
# in the Supabase dashboard only). Leave unset to skip the captcha step
# entirely; see src/components/HCaptchaModal.tsx.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=
