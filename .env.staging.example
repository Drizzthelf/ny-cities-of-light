# Values for the STAGING Supabase project (pre-release testing only —
# never point this at production data). Copy to .env.staging and fill in
# from that project's Project Settings → API page.
EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key-here
# hCaptcha site key (public — the matching secret key goes in the Supabase
# dashboard, never here). Leave unset to skip the captcha step entirely.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here
